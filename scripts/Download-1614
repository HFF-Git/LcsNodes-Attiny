#!/bin/bash

# Configuration
DEVICE=attiny1614
PORT=/dev/cu.usbserial-0001

# Check argument
if [ "$#" -ne 1 ]; then
    echo "Usage: ./flash.sh <firmware.hex>"
    exit 1
fi

HEX="$1"

if [ ! -f "$HEX" ]; then
    echo "File not found: $HEX"
    exit 1
fi

echo "=================================="
echo " Device: $DEVICE"
echo " Port:   $PORT"
echo " File:   $HEX"
echo "=================================="

read -p "Program device? (y/N) " answer

if [[ "$answer" != "y" && "$answer" != "Y" ]]; then
    echo "Aborted."
    exit 0
fi

# Program and verify
pymcuprog write \
    -t uart \
    -u "$PORT" \
    -d "$DEVICE" \
    -f "$HEX" \
    --erase \
    --verify

if [ $? -eq 0 ]; then
    echo "Programming successful!"
else
    echo "Programming FAILED!"
    exit 1
fi